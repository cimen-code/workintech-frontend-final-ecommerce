+            <h3 className="border-b border-[#ECECEC] pb-6 text-2xl font-bold leading-8 tracking-[0.1px] text-text-color">BESTSELLER PRODUCTS</h3>
+            <div className="flex flex-col gap-[30px] md:flex-row md:flex-wrap">
