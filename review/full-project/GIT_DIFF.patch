+                  <button type="button" aria-label="Quick view" className="flex h-10 w-10 items-center justify-center rounded-full border border-[#E8E8E8] bg-white">
+                    <Eye size={20} />
+                  </button>
+                </div>
+              </div>
+            </div>
+          )}
+        </div>
+      </section>
+
+      {!isLoading && product && (
